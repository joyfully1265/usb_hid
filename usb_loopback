#!/bin/bash

# Navigate to the USB gadget config directory
cd /sys/kernel/config/usb_gadget/ || exit 1

# Create the gadget directory and enter it
mkdir -p keyboard
cd keyboard || exit 1

# Configure Device IDs
echo 0x1d6b > idVendor       # Linux Foundation
echo 0x0104 > idProduct      # Multifunction Composite Gadget
echo 0x0100 > bcdDevice      # v1.0.0
echo 0x0200 > bcdUSB         # USB2

# Device strings (English US)
mkdir -p strings/0x409
echo "abcd1234" > strings/0x409/serialnumber
echo "nexonfucker" > strings/0x409/manufacturer
echo "Keyboard USB Device" > strings/0x409/product

# Configuration definition
mkdir -p configs/c.1/strings/0x409
echo "Config 1: ECM network" > configs/c.1/strings/0x409/configuration
echo 600 > configs/c.1/MaxPower

# ==========================================
# FUNCTION 1: KEYBOARD
# ==========================================
mkdir -p functions/hid.usb0
echo 1 > functions/hid.usb0/protocol
echo 1 > functions/hid.usb0/subclass
echo 8 > functions/hid.usb0/report_length

# Keyboard report descriptor
echo -ne \\x05\\x01\\x09\\x06\\xa1\\x01\\x05\\x07\\x19\\xe0\\x29\\xe7\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\x95\\x01\\x75\\x08\\x81\\x03\\x95\\x05\\x75\\x01\\x05\\x08\\x19\\x01\\x29\\x05\\x91\\x02\\x95\\x01\\x75\\x03\\x91\\x03\\x95\\x06\\x75\\x08\\x15\\x00\\x25\\x65\\x05\\x07\\x19\\x00\\x29\\x65\\x81\\x00\\xc0 > functions/hid.usb0/report_desc

# Link keyboard function to configuration
ln -s functions/hid.usb0 configs/c.1/

# ==========================================
# FUNCTION 2: MOUSE
# ==========================================
mkdir -p functions/hid.usb1
echo 0 > functions/hid.usb1/protocol        # 2 is for Mouse
echo 0 > functions/hid.usb1/subclass        # Boot interface subclass
echo 6 > functions/hid.usb1/report_length    # 4 bytes: buttons, X, Y, wheel

# Mouse report descriptor
echo -ne \\x05\\x01\\x09\\x02\\xa1\\x01\\x09\\x01\\xa1\\x00\\x05\\x09\\x19\\x01\\x29\\x05\\x15\\x00\\x25\\x01\\x95\\x05\\x75\\x01\\x81\\x02\\x95\\x01\\x75\\x03\\x81\\x03\\x05\\x01\\x09\\x30\\x09\\x31\\x15\\x00\\x26\\xff\\x7f\\x75\\x10\\x95\\x02\\x81\\x02\\x05\\x01\\x09\\x38\\x15\\x81\\x25\\x7f\\x75\\x08\\x95\\x01\\x81\\x06\\xc0\\xc0 > functions/hid.usb1/report_desc
# Link mouse function to configuration
ln -s functions/hid.usb1 configs/c.1/

# ==========================================
# Enable the Gadget
# ==========================================
ls /sys/class/udc > UDC

